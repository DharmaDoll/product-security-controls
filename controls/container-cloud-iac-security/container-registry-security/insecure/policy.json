{
  "schema": "psb-container-registry-policy/v1",
  "policy_version": "latest",
  "registries": [
    {
      "id": "*",
      "endpoint": "http://registry.example.invalid",
      "minimum_tls_version": "TLS1.0",
      "trusted_ca_sha256": "*"
    }
  ],
  "authorization": {
    "default": "allow",
    "public_anonymous_pull_repositories": ["*"],
    "roles": [
      {
        "id": "developer-admin",
        "actors": ["*"],
        "repositories": ["*"],
        "actions": ["admin", "delete", "pull", "push", "read-audit"]
      }
    ]
  },
  "identity": {
    "source_control": "manual-secret",
    "credential_kind": "static-password",
    "audience": "*",
    "maximum_ttl_seconds": 86400,
    "stored_credentials_allowed": true
  },
  "release_protection": {
    "protected_repositories": ["payments/api"],
    "protected_tag_prefixes": ["release-"],
    "allow_tag_overwrite": true,
    "allow_protected_digest_delete": true
  },
  "audit": {
    "required_actions": ["admin"],
    "sensitive_read_repositories": [],
    "required_fields": ["actor", "action"],
    "maximum_lag_seconds": 86400,
    "minimum_retention_days": 0
  },
  "lifecycle": {
    "allowed_states": ["active", "removed"],
    "state_transitions": {
      "active": ["removed"],
      "removed": []
    },
    "maximum_active_age_days": 3650,
    "deprecation_removal_days": 3650,
    "maximum_quarantine_days": 3650,
    "stale_action": "ignore",
    "evidence_error_action": "quarantine"
  },
  "evidence": {
    "maximum_age_seconds": 86400,
    "required_sources": ["registry-api"]
  }
}
