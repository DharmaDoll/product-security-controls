{
  "schema": "psb-cicd-control-plane-policy/v1",
  "policy_version": "latest",
  "maximum_evidence_age_seconds": 86400,
  "maximum_session_seconds": 43200,
  "maximum_reauthentication_age_seconds": 43200,
  "minimum_independent_approvals": 0,
