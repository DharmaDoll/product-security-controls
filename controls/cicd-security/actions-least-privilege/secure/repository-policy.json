{
  "schema_version": "psb-github-actions-permissions-policy/v1",
  "workflow_roots": [".github/workflows"],
  "workflows": [
    {
      "path": ".github/workflows/ci.yml",
      "jobs": {
        "verify": {
          "purpose": "test",
          "permissions": {
            "contents": "read"
          }
        }
      }
    },
    {
      "path": ".github/workflows/actions-security.yml",
      "jobs": {
        "gate": {
          "purpose": "test",
          "permissions": {
            "contents": "read"
          }
        },
        "report": {
          "purpose": "report",
          "permissions": {
            "actions": "read",
            "contents": "read",
            "security-events": "write"
          },
          "required_if": "github.event_name == 'push' && github.ref == 'refs/heads/main'"
        }
      }
    }
  ]
}
