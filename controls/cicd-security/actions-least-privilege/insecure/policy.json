{
  "schema_version": "psb-github-actions-permissions-policy/v1",
  "workflow_roots": ["."],
  "workflows": [
    {
      "path": "workflow.yml",
      "jobs": {
        "test": {
          "purpose": "test",
          "permissions": {
            "contents": "read"
          }
        },
        "report": {
          "purpose": "report",
          "permissions": {
            "actions": "read",
            "contents": "read",
            "security-events": "write"
          },
          "required_if": "github.event_name == 'push' && github.ref == 'refs/heads/main'"
        },
        "release": {
          "purpose": "release",
          "permissions": {
            "attestations": "write",
            "contents": "write",
            "id-token": "write",
            "packages": "write"
          },
          "required_if": "github.ref == 'refs/tags/v1.0.0'",
          "environment": "release"
        },
        "deploy": {
          "purpose": "deploy",
          "permissions": {
            "contents": "read",
            "deployments": "write",
            "id-token": "write"
          },
          "required_if": "github.ref == 'refs/tags/v1.0.0'",
          "environment": "production"
        },
        "reusable-check": {
          "purpose": "test",
          "permissions": {
            "contents": "read"
          }
        }
      }
    }
  ]
}
