{
  "schema_version": "psb-github-actions-untrusted-boundary-policy/v1",
  "workflow_roots": [
    "."
  ],
  "workflows": [
    {
      "path": "workflow.yml",
      "events": [
        "pull_request_target",
        "workflow_run"
      ],
      "jobs": {
        "pwn": {
          "trust": "untrusted",
          "runner": "ubuntu-latest"
        },
        "reuse": {
          "trust": "untrusted",
          "runner": "ubuntu-latest"
        },
        "elevate": {
          "trust": "trusted",
          "runner": "ubuntu-latest",
          "required_if": "github.event_name == 'push' && github.ref == 'refs/heads/main'"
        }
      }
    }
  ]
}
