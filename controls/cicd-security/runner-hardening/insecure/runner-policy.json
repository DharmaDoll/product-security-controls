{
  "schema": "psb-ci-runner-policy/v1",
  "policy_version": "runner-hardening-latest",
  "maximum_evidence_age_seconds": 86400,
  "maximum_registration_token_seconds": 3600,
  "maximum_teardown_seconds": 3600,
  "profiles": [
    {
      "id": "shared-runner",
      "provider_type": "self-hosted-persistent",
      "accepted_trust_classes": ["untrusted", "trusted"],
      "runner_labels": ["self-hosted"],
      "runner_group": "all-repositories",
      "allowed_repositories": ["*"],
      "allowed_workflows": ["*"],
      "allowed_events": ["pull_request", "push"],
      "lifecycle_assurance_source": "operator-assumption",
      "self_hosted": true,
      "ephemeral": false,
      "jit": false,
      "maximum_jobs": 0,
      "reuse_underlying_host": true,
      "image_update_mode": "in-place",
      "internal_network_access": true
    }
  ],
  "network_boundary": {
    "default_egress": "allow",
    "allowed_control_plane_origins": ["*"],
    "cloud_metadata_ipv4_blocked": false,
    "cloud_metadata_ipv6_blocked": false,
    "management_network_blocked": false,
    "host_runtime_sockets_absent": false
  },
  "management": {
    "interactive_ingress": "ssh-from-corporate-network",
    "break_glass_separate": false,
    "registration_token_one_use": false,
    "registration_token_retained": true
  },
  "teardown": {
    "deregister": false,
    "destroy_compute": false,
    "discard_workspace": false,
    "destroy_ephemeral_storage_key": false,
    "terminate_job_processes": false,
    "export_logs_before_destroy": false
  }
}
