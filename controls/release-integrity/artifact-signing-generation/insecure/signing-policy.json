{
  "schema": "psb-artifact-signing-policy/1.0",
  "profile": "insecure",
  "expected": {
    "artifact_family": "example-cli",
    "artifact_name": "example-cli-linux-amd64",
    "release_id": "example-cli/latest",
    "release_ref": "refs/heads/main",
    "source_repository": "https://github.com/example/security-reference",
    "source_revision": "abcdef1",
    "workload_identity": "repo:example/security-reference:*",
    "audience": "https://signer.example.invalid",
