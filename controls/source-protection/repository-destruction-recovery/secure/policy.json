{
  "schema": "psb-repository-destruction-recovery-policy/v2",
  "policy_id": "repository-recovery-policy@sha256:a944b38f6e639fdb738f686180fa7f7cd152a8a66498616e440af33fcf747f50",
  "required_repository_ids": ["1001", "1002"],
  "max_bulk_delete_targets": 1,
  "deletion_control": {
    "default_deny": true,
    "independent_approval": true,
    "phishing_resistant_reauthentication": true,
    "reauthentication_max_age_seconds": 900
  },
  "recovery_copy": {
    "max_rpo_seconds": 86400,
    "minimum_retention_days": 30,
    "separate_security_domain": true,
    "lock_mode": "compliance",
    "source_admin_delete_denied": true
  },
  "restore": {
    "max_rto_seconds": 14400,
    "max_drill_age_seconds": 2592000,
    "isolated_target_required": true,
    "complete_refs_required": true,
    "protected_settings_required": true
  },
  "max_evidence_age_seconds": 86400,
  "max_document_bytes": 1048576,
  "evidence_mode": "metadata-only"
}
