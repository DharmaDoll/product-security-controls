#!/usr/bin/env sh
set -eu

remote_name="${PRE_COMMIT_REMOTE_NAME:-}"
local_ref="${PRE_COMMIT_LOCAL_BRANCH:-}"
local_oid="${PRE_COMMIT_TO_REF:-}"
remote_ref="${PRE_COMMIT_REMOTE_BRANCH:-}"
remote_oid="${PRE_COMMIT_FROM_REF:-}"

if [ -z "$remote_name" ] || [ -z "$local_ref" ] || [ -z "$local_oid" ] ||
  [ -z "$remote_ref" ] || [ -z "$remote_oid" ]; then
  echo "ERROR pre-commit pre-push context is incomplete" >&2
  exit 2
fi

repository_root="$(git rev-parse --show-toplevel)" || exit 2
printf '%s %s %s %s\n' "$local_ref" "$local_oid" "$remote_ref" "$remote_oid" |
  python3 "$repository_root/.githooks/scan-sensitive.py" \
    --pre-push "$remote_name"
