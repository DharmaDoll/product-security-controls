{
  "servers": {
    "github": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "ghcr.io/github/github-mcp-server:latest"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "hardcoded-placeholder",
        "GITHUB_READ_ONLY": "0",
        "GITHUB_TOOLSETS": "all"
      }
    }
  }
}
