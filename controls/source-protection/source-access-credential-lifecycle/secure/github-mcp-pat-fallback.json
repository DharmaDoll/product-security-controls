{
  "inputs": [
    {
      "type": "promptString",
      "id": "github_token",
      "description": "GitHub MCP dedicated fine-grained PAT",
      "password": true
    }
  ],
  "servers": {
    "github": {
      "type": "stdio",
      "command": "/opt/product-security/bin/github-mcp-server-reviewed",
      "args": [
        "stdio",
        "--read-only",
        "--toolsets",
        "context,repos,pull_requests"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}",
        "GITHUB_READ_ONLY": "1",
        "GITHUB_TOOLSETS": "context,repos,pull_requests"
      }
    }
  }
}
