{
  "schema_version": "psb-ai-fleet-telemetry-policy/v1",
  "policy_id": "PSB-AI-004-FLEET-TELEMETRY",
  "policy_revision": "2026-07-29.1",
  "required_providers": [
    "claude-code",
    "codex"
  ],
  "maximum_snapshot_age_seconds": 3600,
  "maximum_ingestion_lag_seconds": 300,
  "maximum_alert_test_age_seconds": 86400,
  "maximum_alert_delivery_latency_seconds": 120,
  "required_enrollment_status": "enrolled",
  "required_content_classification": "metadata-only",
  "allowed_event_fields": [
    "schema_version",
    "timestamp",
    "control_id",
    "policy_revision",
    "provider",
    "session_ref",
    "event_ref",
    "tool_ref",
    "decision",
    "reason_code",
    "request_ref",
    "approval_ref"
  ],
  "forbidden_content_fields": [
    "prompt",
    "transcript",
    "tool_input",
    "arguments",
    "parameters",
    "target",
    "body",
    "tool_output",
    "credential",
    "signature",
    "private_url",
    "permit"
  ],
  "required_alert_rules": [
    "unknown-extension",
    "hook-failure",
    "audit-sink-failure",
    "gateway-bypass",
    "approval-replay",
    "reconciliation-unknown",
    "command-broker-bypass"
  ]
}
