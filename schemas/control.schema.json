{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DharmaDoll/product-security-controls/schemas/control.schema.json",
  "title": "Product Security Blueprint control",
  "type": "object",
  "required": [
    "id",
    "title",
    "domain",
    "summary",
    "security_functions",
    "threats",
    "implementations",
    "verification",
    "mappings",
    "limitations",
    "status",
    "owner",
    "evidence_level"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PSB-[A-Z]+-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "secure-design",
        "secure-coding",
        "source-protection",
        "dependency-security",
        "cicd-security",
        "build-security",
        "container-cloud-iac-security",
        "release-integrity",
        "ai-development-security",
        "detection-verification",
        "governance-operations"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "security_functions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["prevent", "detect", "verify", "respond", "govern"]
      }
    },
    "threats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "implementations": {
      "type": "object",
      "required": ["insecure", "secure"],
      "properties": {
        "insecure": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "secure": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["commands", "expected"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "expected": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "framework",
          "version",
          "id",
          "relationship",
          "confidence",
          "rationale",
          "reviewer",
          "review_date"
        ],
        "properties": {
          "framework": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "id": {"type": "string", "minLength": 1},
          "relationship": {
            "enum": [
              "addresses",
              "supports",
              "detects",
              "mitigates",
              "verifies",
              "evidence-for",
              "related-to"
            ]
          },
          "confidence": {"enum": ["low", "medium", "high"]},
          "rationale": {"type": "string", "minLength": 1},
          "reviewer": {"type": "string", "minLength": 1},
          "review_date": {"type": "string", "format": "date"}
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "status": {
      "enum": ["idea", "planned", "prototype", "reference", "adopted", "deprecated"]
    },
    "owner": {"type": "string", "minLength": 1},
    "evidence_level": {"enum": ["E0", "E1", "E2", "E3", "E4"]}
  },
  "additionalProperties": false
}
