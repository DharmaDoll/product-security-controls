{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DharmaDoll/product-security-controls/schemas/control.schema.json",
  "title": "Product Security Blueprint control",
  "type": "object",
  "required": [
    "id",
    "title",
    "domain",
    "summary",
    "security_functions",
    "threats",
    "implementations",
    "verification",
    "check_context_version",
    "checks",
    "mappings",
    "limitations",
    "status",
    "owner",
    "evidence_level"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PSB-[A-Z]+-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "secure-design",
        "secure-coding",
        "source-protection",
        "dependency-security",
        "cicd-security",
        "build-security",
        "container-cloud-iac-security",
        "release-integrity",
        "ai-development-security",
        "detection-verification",
        "governance-operations"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "security_functions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["prevent", "detect", "verify", "respond", "govern"]
      }
    },
    "threats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "implementations": {
      "type": "object",
      "required": ["insecure", "secure"],
      "properties": {
        "insecure": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "secure": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["expected"],
      "properties": {
        "type": {
          "enum": ["automated", "manual", "external-evidence", "hybrid"]
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "procedure": {"type": "string", "minLength": 1},
        "expected": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": {"enum": ["manual", "external-evidence"]}
            }
          },
          "then": {"required": ["procedure"]},
          "else": {"required": ["commands"]}
        }
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": [
        "command",
        "platforms",
        "output_formats",
        "result_statuses"
      ],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["linux", "macos", "windows"]}
        },
        "output_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["json", "csv"]}
        },
        "result_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["PASS", "FAIL", "NOT_CHECKED", "ERROR", "N/A"]
          }
        }
      },
      "additionalProperties": false
    },
    "check_context_version": {
      "const": "1.0"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "required_state",
          "responsible_role",
          "applies_to",
          "verification",
          "mapping_status",
          "context"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
          },
          "title": {"type": "string", "minLength": 1},
          "required_state": {"type": "string", "minLength": 1},
          "responsible_role": {
            "enum": [
              "developer",
              "repository-admin",
              "ci-platform",
              "build-platform",
              "release-manager",
              "security",
              "incident-response",
              "shared"
            ]
          },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "verification": {
            "type": "object",
            "required": ["type", "method", "expected", "evidence"],
            "properties": {
              "type": {
                "enum": ["automated", "manual", "external-evidence", "hybrid"]
              },
              "method": {"type": "string", "minLength": 1},
              "expected": {"type": "string", "minLength": 1},
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          },
          "mapping_status": {
            "enum": ["reviewed", "provisional", "unmapped"]
          },
          "context": {
            "type": "object",
            "required": [
              "threat_actor",
              "attack_or_failure_scenario",
              "why_required"
            ],
            "properties": {
              "threat_actor": {"type": "string", "minLength": 1},
              "attack_or_failure_scenario": {"type": "string", "minLength": 1},
              "why_required": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "framework",
          "version",
          "id",
          "relationship",
          "confidence",
          "rationale",
          "reviewer",
          "review_date",
          "applies_to"
        ],
        "properties": {
          "framework": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "id": {"type": "string", "minLength": 1},
          "relationship": {
            "enum": [
              "addresses",
              "supports",
              "detects",
              "mitigates",
              "verifies",
              "evidence-for",
              "related-to"
            ]
          },
          "confidence": {"enum": ["low", "medium", "high"]},
          "rationale": {"type": "string", "minLength": 1},
          "reviewer": {"type": "string", "minLength": 1},
          "review_date": {"type": "string", "format": "date"},
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "status": {
      "enum": ["idea", "planned", "prototype", "reference", "adopted", "deprecated"]
    },
    "owner": {"type": "string", "minLength": 1},
    "evidence_level": {"enum": ["E0", "E1", "E2", "E3", "E4"]}
  },
  "additionalProperties": false
}
