{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DharmaDoll/product-security-controls/schemas/slsa-build-l2-issuer-bundle.schema.json",
  "title": "SLSA Build L2 issuer evidence bundle",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "issuer_role",
    "scope_sha256",
    "observed_at",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "psb-slsa-build-l2-issuer-bundle/v1"
    },
    "profile_id": {
      "const": "slsa-build-l2"
    },
    "issuer_role": {
      "enum": [
        "build-platform",
        "consumer",
        "security-monitor",
        "security-review",
        "software-producer"
      ]
    },
    "scope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "type",
          "uri",
          "sha256",
          "result",
          "immutable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uri": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "result": {
            "enum": ["pass", "finding", "error"]
          },
          "immutable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
