{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DharmaDoll/product-security-controls/schemas/slsa-build-platform-security-review.schema.json",
  "title": "Signed SLSA Build L2 platform security review record",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "scope_sha256",
    "reviewer",
    "reviewed_at",
    "expires_at",
    "platform_capability_assessment",
    "signer_ownership_assessment",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "psb-slsa-build-platform-security-review/v1"
    },
    "profile_id": {
      "const": "slsa-build-l2"
    },
    "scope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewer": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": {
          "$ref": "#/$defs/httpsUri"
        },
        "role": {
          "const": "security-review"
        }
      },
      "additionalProperties": false
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "platform_capability_assessment": {
      "type": "object",
      "required": [
        "result",
        "build_platform_id",
        "target_level",
        "hosted_execution",
        "consistent_build_process",
        "control_plane_provenance_generation",
        "evidence_uri",
        "evidence_sha256"
      ],
      "properties": {
        "result": {
          "enum": ["pass", "finding"]
        },
        "build_platform_id": {
          "$ref": "#/$defs/httpsUri"
        },
        "target_level": {
          "const": 2
        },
        "hosted_execution": {
          "type": "boolean"
        },
        "consistent_build_process": {
          "type": "boolean"
        },
        "control_plane_provenance_generation": {
          "type": "boolean"
        },
        "evidence_uri": {
          "$ref": "#/$defs/httpsUri"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "signer_ownership_assessment": {
      "type": "object",
      "required": [
        "result",
        "signer_id",
        "platform_owned_identity",
        "tenant_signing_capability",
        "rotation_and_revocation_reviewed",
        "evidence_uri",
        "evidence_sha256"
      ],
      "properties": {
        "result": {
          "enum": ["pass", "finding"]
        },
        "signer_id": {
          "$ref": "#/$defs/httpsUri"
        },
        "platform_owned_identity": {
          "type": "boolean"
        },
        "tenant_signing_capability": {
          "type": "boolean"
        },
        "rotation_and_revocation_reviewed": {
          "type": "boolean"
        },
        "evidence_uri": {
          "$ref": "#/$defs/httpsUri"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  }
}
